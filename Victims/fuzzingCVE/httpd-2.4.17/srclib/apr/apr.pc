prefix=/usr/local/apache_afl_cve/
exec_prefix=/usr/local/apache_afl_cve/
libdir=${prefix}/lib
APR_MAJOR_VERSION=1
includedir=/usr/local/apache_afl_cve//include

Name: APR
Description: The Apache Portable Runtime library
Version: 1.7.6
Libs: -L${libdir} -lapr-${APR_MAJOR_VERSION} -lcrypt  -lpthread
Cflags: -DLINUX -D_REENTRANT -D_GNU_SOURCE -g -O2 -I${includedir}
