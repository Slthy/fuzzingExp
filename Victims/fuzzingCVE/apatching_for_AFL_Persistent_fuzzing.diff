+static void *GETDATA(void *arg)
+{
+    int BUFSIZE=1024*1024;
+    usleep(10000);
+    char buf[BUFSIZE+1];
+    while ( __AFL_LOOP(10000)){
+        printf("[+] Looping\n");
+        memset(buf, 0, BUFSIZE);
+        ssize_t read_bytes = read(0, buf, BUFSIZE - 3);
+        if (read_bytes <= 0) {
+            continue;
+        }
+        buf[read_bytes] = '\r';
+        buf[read_bytes + 1] = '\n';
+        buf[read_bytes + 2] = '\0';
+        
+        int sockfd = socket(AF_INET, SOCK_STREAM, IPPROTO_IP);
+        if (sockfd == -1) {
+            perror("socket");
+            _exit(1);
+        }
+
+        int sz = (1024 * 1024);
+        if (setsockopt(sockfd, SOL_SOCKET, SO_SNDBUF, &sz, sizeof(sz)) == -1) {
+            perror("setsockopt");
+            exit(1);
+        }
+
+        printf("[+] Connecting\n");
+
+        struct sockaddr_in saddr;
+        saddr.sin_family = AF_INET;
+        saddr.sin_port = htons(80);
+        saddr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        if (connect(sockfd, (struct sockaddr *)&saddr, sizeof(saddr)) == -1) {
+            printf("[-] Connect failed\n");
+            perror("connect");
+            close(sockfd);
+            continue;
+        }
+
+        printf("[+] Sending buf %s\n", buf);
+
+        if (send(sockfd, buf, (size_t)read_bytes + 2, MSG_NOSIGNAL) != (ssize_t)((size_t)read_bytes + 2)) {
+            perror("send() failed 1");
+            close(sockfd);
+            continue;
+        }
+
+        printf("[+] Buf sent %s\n", buf);
+
+        if (shutdown(sockfd, SHUT_WR) == -1) {
+            perror("shutdown");
+            close(sockfd);
+            continue;
+        }
+
+        char b[1024 * 1024];
+        while (recv(sockfd, b, sizeof(b), 0) > 0) ;
+
+        printf("[+] Received %s\n", b);
+
+        close(sockfd);
+        printf("[+] Nice run\n");
+    }
+    printf("[+] Whew lad!\n");
+    usleep(100000);
+    _exit(0);
+    return NULL;
+}
